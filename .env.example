# Заявки с сайта уходят в Telegram-бота. Без этих двух переменных форма честно говорит, что не подключена.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Пиксели ретаргетинга (концепция: «ставим с первого дня»). Пусто: скрипты не грузятся.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_ID=
# Боевой адрес сайта для sitemap, canonical и Open Graph
NEXT_PUBLIC_SITE_URL=https://kurak.kg
# Куда форма шлёт заявку. По умолчанию /api/lead (серверная сборка); на GitHub Pages пусто, форма в демо-режиме
NEXT_PUBLIC_LEAD_ENDPOINT=
